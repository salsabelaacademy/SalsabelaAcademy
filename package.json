{
  "name": "rest-express",
  "version": "1.0.0",
  "type": "module",
  "license": "MIT",
  "scripts": {
    "dev": "NODE_ENV=development node --env-file-if-exists=.env --import tsx server/index.ts",
    "build": "node --import tsx script/build.ts",
    "start": "NODE_ENV=production node dist/index.cjs",
    "check": "tsc",
    "db:push": "drizzle-kit push",
    "db:migrate:fresh": "drizzle-kit migrate",
    "seed:programs": "tsx script/seed-programs.ts",
    "db:migrate:phase3": "node --import tsx script/apply-phase3.ts",
    "db:migrate:phase4": "node --import tsx script/apply-phase4.ts",
    "db:migrate:phase5": "node --import tsx script/apply-phase5.ts",
    "lint": "eslint client/src server shared",
    "admin:bootstrap": "node --import tsx script/bootstrap-admin.ts",
    "catalog:check": "node --env-file-if-exists=.env --import tsx script/restore-catalogue.ts",
    "catalog:restore": "node --env-file-if-exists=.env --import tsx script/restore-catalogue.ts --apply",
    "verify": "npm run check && npm run lint && npm run build",
    "db:migrate:home": "node --env-file-if-exists=.env --import tsx script/apply-home-content.ts",
    "db:migrate:push": "node --env-file-if-exists=.env --import tsx script/apply-push.ts",
    "predev": "node --import tsx script/prepare-backgrounds.ts",
    "images:prepare": "node --import tsx script/prepare-backgrounds.ts",
    "db:migrate:followup": "node --env-file-if-exists=.env --import tsx script/apply-followup.ts",
    "db:migrate:account": "node --env-file-if-exists=.env --import tsx script/apply-account-details.ts",
    "db:migrate:dashboard": "node --env-file-if-exists=.env --import tsx script/apply-dashboard-communication.ts",
    "db:migrate:email": "node --env-file-if-exists=.env --import tsx script/apply-email-preferences.ts"
  },
